		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"axe-core": "^4.14.0",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
